# ---------------------------------------------------------------------------
# Core Django settings
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Add your LAN IP here when testing from a phone, e.g. localhost,127.0.0.1,192.168.1.11
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Preferred: a single DATABASE_URL (parsed by django-environ).
#
#   PostgreSQL : postgres://USER:PASSWORD@HOST:PORT/NAME
#   SQLite     : sqlite:///db.sqlite3      (handy for local dev / CI)
#
# NOTE: if your password contains characters like @ : / they must be
# URL-encoded (e.g. @ -> %40).  When that is inconvenient, leave
# DATABASE_URL unset and use the discrete DB_* keys below instead.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/qr_attendace

# Discrete fallback keys (only used when DATABASE_URL is NOT set)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=qr_attendace
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# CORS (development only). With DEBUG=True any http://localhost:<port> origin is
# already allowed (Flutter web). CORS_ALLOW_ALL_ORIGINS=True is refused when
# DEBUG=False; production uses an explicit CORS_ALLOWED_ORIGINS list.
# ---------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=http://localhost:5000

# ---------------------------------------------------------------------------
# Production / Docker: see .env.prod.example and DEPLOYMENT.md
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Celery + Redis (background fine calculation)
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set True to run tasks inline without a broker (tests / no-Redis dev).
CELERY_TASK_ALWAYS_EAGER=False
