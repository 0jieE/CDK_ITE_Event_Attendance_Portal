# =============================================================================
# Production / demo environment for docker-compose.
#
#   cp .env.prod.example .env.prod      (.env.prod is gitignored - never commit it)
#   docker compose --env-file .env.prod up -d --build
#
# Rules for values (compose and Django both parse this file):
#   * no spaces around '=', no quotes needed, avoid '$' and '#' inside values
#   * lists are comma-separated, no spaces
# =============================================================================

# ---- Django core ------------------------------------------------------------
# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string
# Must stay False in production.
DEBUG=False
# Hostnames/IPs users reach the site by. No '*'. Keep `localhost` - the
# container health check calls Django with that Host header.
ALLOWED_HOSTS=localhost,127.0.0.1,attendance.example.com
# Full origins (scheme included) allowed to POST to the portal/admin.
# Match your public URL exactly, e.g. https://attendance.example.com or
# http://192.168.1.20 for a plain-HTTP demo.
CSRF_TRUSTED_ORIGINS=https://attendance.example.com

# ---- HTTPS switch (the one knob to flip for a plain-HTTP demo) ---------------
# True  = redirect HTTP->HTTPS, Secure cookies, HSTS. The site MUST be reachable
#         over HTTPS (NGINX_CONF=nginx.ssl.conf, or a TLS proxy in front).
# False = plain-HTTP demo (e.g. http://192.168.1.20): no redirect, no Secure
#         cookies, no HSTS. Update CSRF_TRUSTED_ORIGINS to the http:// origin.
USE_HTTPS=True
# Trust nginx's X-Forwarded-Proto header (leave True with this compose file).
TRUST_PROXY_SSL_HEADER=True
# HSTS lifetime in seconds (only used when USE_HTTPS=True). Keep it low (e.g.
# 300) while you are still testing HTTPS, because browsers cache it.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ---- nginx -------------------------------------------------------------------
# nginx.conf     = plain HTTP on :80 (demo, or behind your own TLS terminator)
# nginx.ssl.conf = nginx terminates HTTPS using nginx/certs/{fullchain,privkey}.pem
NGINX_CONF=nginx.conf
HTTP_PORT=80
HTTPS_PORT=443

# ---- Database ----------------------------------------------------------------
# Option A (default): a managed PostgreSQL such as Render. Use its *External*
# URL when running Docker on your own machine (the Internal URL only works from
# inside Render's network) and keep ?sslmode=require. Special characters in the
# password must be percent-encoded (@ -> %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.singapore-postgres.render.com/DBNAME?sslmode=require

# Option B: PostgreSQL in a local container. Remove DATABASE_URL above, set these
# and start with `--profile local-db` (host/port are set by docker-compose).
# Use a strong password; avoid '@ : / $ #'.
# DB_NAME=qr_attendance
# DB_USER=qr_attendance
# DB_PASSWORD=replace-me-with-a-strong-db-password

# ---- Media storage: Cloudinary (profile photos, QR PNGs, portal logo) --------
# Find all three on https://console.cloudinary.com -> Dashboard / API Keys.
# When set, every uploaded image lives in ONE folder (below) on Cloudinary and
# survives redeploys. Leave blank to fall back to local disk (dev only).
# After filling these run once:  python manage.py cloudinary_setup
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ite-attendance

# ---- First-run Department Adviser admin -------------------------------------
# Created ONCE if missing. Existing admins are never modified on restart, so
# a password changed in the portal sticks. The dev default is refused.
ADMIN_USERNAME=adviser
ADMIN_PASSWORD=replace-me-with-a-strong-admin-password

# ---- CORS (JSON API, browser clients only) ----------------------------------
# The Flutter mobile app does not use CORS. Only list browser origins that call
# /api/ from another origin (e.g. a Flutter *web* build). Empty is fine.
# Example: CORS_ALLOWED_ORIGINS=https://attendance.example.com,http://localhost:5000
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=False

# ---- API tokens & throttling -------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Reverse proxies in front of Django (nginx = 1; nginx behind another proxy or
# CDN = 2). Needed so throttling sees the real client IP.
NUM_PROXIES=1
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_LOGIN=10/min
THROTTLE_REFRESH=30/min
THROTTLE_SCAN=120/min

# ---- Gunicorn ----------------------------------------------------------------
# Defaults to min(2*CPU+1, 5). Set explicitly on small machines.
# WEB_CONCURRENCY=3
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=30

# ---- Background fines recompute (only with `--profile celery`) ---------------
# Without the profile these are unused: the portal "Calculate Fines" button
# falls back to computing synchronously.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
